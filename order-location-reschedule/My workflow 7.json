    {
      "parameters": {
        "jsCode": "const order = $input.item.json.body || {};\nconst token = require('crypto').randomUUID();\n\n// Set default delivery date to 3 days from now\nconst deliveryDate = new Date();\ndeliveryDate.setDate(deliveryDate.getDate() + 3);\n\n// Generate Google Calendar Link\nconst text = encodeURIComponent('Package Delivery: ' + (order.id || '12345'));\nconst dateString = deliveryDate.toISOString().replace(/-|:|_/g, '').substring(0, 15) + 'Z';\nconst calLink = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${text}&dates=${dateString}/${dateString}`;\n\nreturn {\n  orderId: order.id,\n  customerPhone: order.phone,\n  token: token,\n  deliveryDate: deliveryDate.toISOString(),\n  calLink: calLink,\n  portalUrl: `http://localhost:3000/delivery?token=${token}`\n};"
      },
