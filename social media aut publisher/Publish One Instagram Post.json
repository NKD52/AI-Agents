    {
      "parameters": {
        "jsCode": "const ids = $input.all().map(i => i.json.id).filter(Boolean);\nif (!ids.length) { throw new Error('No carousel child containers were created'); }\nconst src = $('When Executed by Another Workflow').first().json;\nreturn [{ json: { children: ids.join(','), ig_user_id: src.ig_user_id, caption: src.caption } }];"
      },
