    {
      "parameters": {
        "jsCode": "const src = $input.first().json;\nconst urls = String(src.media_urls || '').split(',').map(s => s.trim()).filter(Boolean);\nif (urls.length < 2) { throw new Error('Carousel needs at least 2 media_urls, got ' + urls.length); }\nif (urls.length > 10) { throw new Error('Carousel supports at most 10 items, got ' + urls.length); }\nreturn urls.map(u => ({ json: { url: u, ig_user_id: src.ig_user_id } }));"
      },
      "id": "19e7b482-fb5c-453b-a0d9-ef3d22fd9bd6",
