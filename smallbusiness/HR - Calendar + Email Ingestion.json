    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst title = (e.summary || '').toString();\nconst desc = (e.description || '').toString();\nconst combined = (title + ' ' + desc).toLowerCase();\n\n// Extract start date -> event_date (YYYY-MM-DD)\nlet eventDate = '';\nconst startRaw = (e.start && (e.start.dateTime || e.start.date)) || '';\nif (startRaw) eventDate = startRaw.slice(0, 10);\nif (!eventDate) {\n  const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Karachi' }));\n  eventDate = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');\n}\n\n// Try to map an attendee to an employee\nlet employee_name = '';\nlet employee_email = '';\nif (Array.isArray(e.attendees) && e.attendees.length > 0) {\n  employee_name = e.attendees[0].displayName || '';\n  employee_email = e.attendees[0].email || '';\n}\n\n// Derive intent\nlet intent;\nif (/(holiday|festival|eid|christmas|diwali|closed|public holiday)/.test(combined)) {\n  intent = 'Event';           // company-wide holiday/festival\n  employee_name = '';         // not tied to one employee\n  employee_email = '';\n} else if (/overtime|ot\\b/.test(combined)) {\n  intent = 'Overtime';\n} else if (/shift/.test(combined)) {\n  intent = 'Shift';\n} else {\n  intent = employee_name ? 'Shift' : 'Event';\n}\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    employee_id: '',\n    employee_name: employee_name,\n    source: 'calendar',\n    raw_text: title + (desc ? ' - ' + desc : ''),\n    intent: intent,\n    amount: '',\n    event_date: eventDate,\n    status: 'approved',\n    notes: employee_email ? ('attendee: ' + employee_email) : (intent === 'Event' ? 'company-wide event/holiday' : ''),\n  },\n}];"
      },
