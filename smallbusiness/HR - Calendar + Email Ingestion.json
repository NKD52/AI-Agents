    {
      "parameters": {
        "jsCode": "const exRaw = $('Parse Approval Email').item.json;\nconst ex = exRaw.output ? exRaw.output : exRaw;\nconst email = $('Approval Email').item.json;\n\nconst ALLOWED = ['Overtime','Full-Day Leave','Half Day','Sick Leave','Other'];\nlet intent = (ex.intent || 'Other').toString().trim();\nif (!ALLOWED.includes(intent)) intent = 'Other';\n\nlet amount = ex.amount != null ? ex.amount : '';\nif (amount !== '' && (isNaN(Number(amount)) || Number(amount) === 0)) amount = '';\n\nlet eventDate = (ex.event_date || '').toString().trim();\nif (!eventDate) {\n  const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Karachi' }));\n  eventDate = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');\n}\n\nconst rawText = (email.subject || '') + ' :: ' + ((email.text || email.snippet || '').toString().slice(0, 500));\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    employee_id: '',\n    employee_name: (ex.employee_name || '').toString().trim(),\n    source: 'email',\n    raw_text: rawText,\n    intent: intent,\n    amount: amount,\n    event_date: eventDate,\n    status: 'approved',\n    notes: 'manager email approval',\n  },\n}];"
      },
