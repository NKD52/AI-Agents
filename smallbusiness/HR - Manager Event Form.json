    {
      "parameters": {
        "jsCode": "const f = $input.first().json;\n\nconst employeeRaw = (f.employee || '').toString().trim();\n// Heuristic: if it looks like an ID (starts with EMP or is all digits), treat as id\nlet employee_id = '';\nlet employee_name = '';\nif (/^EMP/i.test(employeeRaw) || /^[0-9]+$/.test(employeeRaw)) {\n  employee_id = employeeRaw;\n} else {\n  employee_name = employeeRaw;\n}\n\nconst intent = (f.event_type || 'Note').toString().trim();\n\nlet amount = f.amount;\nif (amount === undefined || amount === null || amount === '') amount = '';\nelse if (isNaN(Number(amount))) amount = '';\n\n// Default event_date to today (Asia/Karachi) if not provided\nlet eventDate = (f.event_date || '').toString().trim();\nif (!eventDate) {\n  const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Karachi' }));\n  const y = now.getFullYear();\n  const m = String(now.getMonth() + 1).padStart(2, '0');\n  const d = String(now.getDate()).padStart(2, '0');\n  eventDate = y + '-' + m + '-' + d;\n}\n\nconst notesParts = [];\nif (f.notes) notesParts.push(String(f.notes));\n// Flag missing amount when the event type needs one\nconst needsAmount = (intent === 'Overtime' || intent === 'Advance Request');\nif (needsAmount && amount === '') notesParts.push('needs amount');\n\nconst rawText = 'Manager logged: ' + intent + (amount !== '' ? (' (' + amount + ')') : '') + (employeeRaw ? ' for ' + employeeRaw : '');\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    employee_id: employee_id,\n    employee_name: employee_name,\n    source: 'form',\n    raw_text: rawText,\n    intent: intent,\n    amount: amount,\n    event_date: eventDate,\n    status: 'approved',\n    notes: notesParts.join(' | '),\n  },\n}];"
      },
