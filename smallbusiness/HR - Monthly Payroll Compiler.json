    {
      "parameters": {
        "jsCode": "const d = $('Build Payslip HTML').item.json;\nconst bin = $input.item.binary;\nconst pdf_ok = !!(bin && bin.data);\n\nconst via = [];\nif (d.has_whatsapp) via.push('whatsapp');\nif (d.has_email) via.push('email');\n\nconst msg = 'Payslip ' + d.pay_period + ' for ' + d.employee_name + '\\n' +\n  'Net Pay: ' + d.net_pay + '\\n' +\n  'Base: ' + d.base_pay + ' | Overtime: ' + d.overtime_pay + '\\n' +\n  'Deductions: ' + (d.penalties + d.advances_deducted) + (d.notes ? ('\\nNotes: ' + d.notes) : '');\n\nconst json = Object.assign({}, d, {\n  pdf_ok: pdf_ok,\n  pdf_url: pdf_ok ? 'attached' : 'FAILED',\n  delivered_via: via.join('+') || 'none',\n  delivered_at: new Date().toISOString(),\n  summary_msg: msg,\n});\n\nreturn [{ json: json, binary: bin }];"
      },
