      "id": "e9f16408-ea8c-4021-b13d-7a3659050510",
      "name": "Read Ledger",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        672,
        576
      ],
      "executeOnce": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "Q9y83emJdM04dg7q",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const employees = $('Read Employees').all().map(i => i.json).filter(e => (e.employee_id || e.employee_name || e.name));\nconst ruleRows = $('Read Rules').all().map(i => i.json);\nconst ledger = $('Read Ledger').all().map(i => i.json);\n\nfunction num(v, d) {\n  if (v === undefined || v === null || v === '') return d;\n  const n = Number(String(v).replace(/[^0-9.\\-]/g, ''));\n  return isNaN(n) ? d : n;\n}\n\n// Build rules map: supports key/value rows OR a single wide row\nconst R = {};\nfor (const r of ruleRows) {\n  if (r.rule !== undefined && r.rule !== '') R[String(r.rule).trim()] = r.value;\n}\nif (ruleRows.length >= 1 && R.overtime_multiplier === undefined) {\n  Object.assign(R, ruleRows[0]);\n}\n\nconst late_grace = num(R.late_grace_minutes, 10);\nconst half_cut = num(R.half_day_cut, 0.5);\nconst unpaid_cut = num(R.unpaid_leave_cut, 1);\nconst ot_mult = num(R.overtime_multiplier, 1.5);\nconst adv_cap = num(R.advance_cap, 1e12);\nconst wdays = num(R.working_days_per_month, 26);\nconst hpd = num(R.hours_per_day, 8);\nconst late_pen = num(R.late_penalty, 0);\n\nconst ruleDefaultsUsed = [];\nif (R.overtime_multiplier === undefined) ruleDefaultsUsed.push('overtime_multiplier=1.5');\nif (R.working_days_per_month === undefined) ruleDefaultsUsed.push('working_days_per_month=26');\n\nconst now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Karachi' }));\nconst period = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0');\n\nconst out = [];\nfor (const emp of employees) {\n  const eid = (emp.employee_id || '').toString().trim();\n  const ename = (emp.employee_name || emp.name || '').toString().trim();\n\n  let monthly = num(emp.monthly_salary || emp.salary, 0);\n  if (monthly === 0 && (emp.daily_rate !== undefined)) monthly = num(emp.daily_rate, 0) * wdays;\n  const daily = wdays > 0 ? monthly / wdays : 0;\n  const hourly = hpd > 0 ? daily / hpd : 0;\n\n  const rows = ledger.filter(r => {\n    const rid = (r.employee_id || '').toString().trim();\n    const rname = (r.employee_name || '').toString().trim();\n    const match = (eid && rid === eid) || ((!rid || rid === '') && ename && rname === ename);\n    const inPeriod = (r.event_date || '').toString().startsWith(period);\n    return match && inPeriod;\n  });\n\n  let overtime_pay = 0, penalties = 0, advances = 0;\n  const flags = [];\n  for (const r of rows) {\n    const intent = (r.intent || '').toString();\n    const status = (r.status || '').toString().toLowerCase();\n    const amt = num(r.amount, 0);\n    if (intent === 'Overtime') {\n      if (status === 'approved') overtime_pay += amt * hourly * ot_mult;\n      else flags.push('overtime pending (' + amt + 'h)');\n    } else if (intent === 'Half Day') {\n      penalties += daily * half_cut;\n    } else if (intent === 'Full-Day Leave') {\n      penalties += amt;\n    } else if (intent === 'Sick Leave') {\n      flags.push('sick leave ' + (r.event_date || ''));\n    } else if (intent === 'Late') {\n      if (amt > late_grace) penalties += late_pen;\n    } else if (intent === 'Advance') {\n      if (status === 'approved') advances += amt;\n      else flags.push('advance pending (' + amt + ')');\n    } else if (intent === 'Unknown') {\n      flags.push('unclassified message needs review');\n    }\n    if ((r.notes || '').toString().includes('needs amount')) flags.push('needs amount: ' + intent);\n  }\n\n  const advCapped = Math.min(advances, adv_cap);\n  if (advances > adv_cap) flags.push('advance capped at ' + adv_cap);\n  overtime_pay = Math.round(overtime_pay);\n  penalties = Math.round(penalties);\n  const net = Math.round(monthly + overtime_pay - penalties - advCapped);\n\n  const whatsapp = (emp.whatsapp || emp.phone || '').toString().trim();\n  const email = (emp.email || '').toString().trim();\n  if (!whatsapp && !email) flags.push('no contact on file - delivery skipped');\n\n  out.push({\n    json: {\n      pay_period: period,\n      employee_id: eid,\n      employee_name: ename,\n      base_pay: monthly,\n      overtime_pay: overtime_pay,\n      advances_deducted: advCapped,\n      penalties: penalties,\n      net_pay: net,\n      whatsapp: whatsapp,\n      email: email,\n      has_whatsapp: !!whatsapp,\n      has_email: !!email,\n      notes: flags.join(' | '),\n      rules_summary: 'OT x' + ot_mult + ', half-day cut ' + half_cut + ', grace ' + late_grace + 'min, advance cap ' + adv_cap + (ruleDefaultsUsed.length ? ' | DEFAULTS: ' + ruleDefaultsUsed.join(',') : ''),\n    },\n  });\n}\nreturn out;"
      },
      "id": "0f8ea2d3-e28d-4552-9263-af82e6e35462",
      "name": "Compute Payroll",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        576
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.item.json;\n\nconst rows = [\n  ['Base Pay', d.base_pay],\n  ['Overtime Pay', d.overtime_pay],\n  ['Penalties (deductions)', '-' + d.penalties],\n  ['Advances Deducted', '-' + d.advances_deducted],\n];\n\n// Map rows to HTML using template literals\nconst trs = rows.map(r => `\n  <tr>\n    <td style=\"padding: 12px 16px; border-bottom: 1px solid #f1f5f9; color: #475569;\">${r[0]}</td>\n    <td style=\"padding: 12px 16px; border-bottom: 1px solid #f1f5f9; text-align: right; font-weight: 500; color: #1e293b;\">${r[1]}</td>\n  </tr>\n`).join('');\n\n// Build the full HTML document\nconst html = `\n<!doctype html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <style>\n    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #334155; background: #f8fafc; padding: 40px; }\n    .payslip-box { max-width: 600px; margin: 0 auto; background: #ffffff; padding: 32px; border: 1px solid #e2e8f0; border-radius: 8px; }\n    .header { border-bottom: 2px solid #e2e8f0; padding-bottom: 16px; margin-bottom: 24px; }\n    .header h2 { margin: 0; color: #0f172a; font-size: 24px; text-transform: uppercase; letter-spacing: 1px; }\n    .header p { margin: 4px 0 0; color: #64748b; font-size: 14px; }\n    .employee-details { margin-bottom: 24px; padding: 16px; background: #f8fafc; border-radius: 6px; border: 1px solid #e2e8f0; }\n    .employee-details p { margin: 4px 0; font-size: 14px; }\n    .employee-details strong { color: #0f172a; width: 130px; display: inline-block; }\n    table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }\n    .net-pay td { padding: 16px; font-weight: 700; font-size: 18px; color: #0f172a; border-top: 2px solid #cbd5e1; background: #f8fafc; }\n    .notes { font-size: 13px; color: #b91c1c; background: #fef2f2; padding: 12px; border-radius: 6px; border: 1px solid #fecaca; margin-bottom: 12px; }\n    .rules { font-size: 11px; color: #94a3b8; text-align: center; border-top: 1px solid #e2e8f0; padding-top: 16px; margin-top: 16px; }\n  </style>\n</head>\n<body>\n  <div class=\"payslip-box\">\n    <div class=\"header\">\n      <h2>Salary Slip</h2>\n      <p>Pay Period: ${d.pay_period}</p>\n    </div>\n    \n    <div class=\"employee-details\">\n      <p><strong>Employee Name:</strong> ${d.employee_name}</p>\n      <p><strong>Employee ID:</strong> ${d.employee_id || 'N/A'}</p>\n    </div>\n\n    <table>\n      <tbody>\n        ${trs}\n        <tr class=\"net-pay\">\n          <td>Net Pay</td>\n          <td style=\"text-align:right\">${d.net_pay}</td>\n        </tr>\n      </tbody>\n    </table>\n\n    ${d.notes ? `<div class=\"notes\"><strong>Notes:</strong> ${d.notes}</div>` : ''}\n    <div class=\"rules\">Rules summary: ${d.rules_summary}</div>\n  </div>\n</body>\n</html>\n`;\n\nreturn [{ json: Object.assign({}, d, { payslip_html: html }) }];"
      },
      "id": "c690ea24-21c0-4fca-a597-1cc3d97fa9f0",
      "name": "Build Payslip HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        384
      ]
    },
    {
      "parameters": {
        "jsCode": "const emps = $('Compute Payroll').all().map(i => i.json);\nconst total = emps.length;\nconst flagged = emps.filter(e => e.notes && e.notes.length > 0);\nconst noContact = emps.filter(e => !e.has_whatsapp && !e.has_email);\nconst totalNet = emps.reduce((s, e) => s + (Number(e.net_pay) || 0), 0);\nreturn [{\n  json: {\n    processed_employees: total,\n    total_net_pay: totalNet,\n    flagged_count: flagged.length,\n    no_contact_count: noContact.length,\n    flagged_employees: flagged.map(e => e.employee_name + ': ' + e.notes),\n    note: total === 0 ? 'No employees found - nothing to process.' : 'Payroll compiled for ' + total + ' employee(s).',\n  },\n}];"
      },
